#!/usr/bin/env bash
set -eo pipefail

# --------------------------
# Logging Configuration
# --------------------------
LOG_FILE="/var/log/erpnext_install.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
LIGHT_BLUE='\033[1;34m'
NC='\033[0m'

log() {
    local level=$1
    local message=$2
    echo -e "$(date +'%Y-%m-%d %H:%M:%S') - [${level}] ${message}"
}

handle_error() {
    log "ERROR" "Failure in ${BASH_SOURCE[1]} line $1 (exit code $2)"
    exit $2
}
trap 'handle_error $LINENO $?' ERR

# --------------------------
# Environment Validation
# --------------------------
validate_environment() {
    log "INFO" "Validating installation environment"
    
    if [[ "${NONINTERACTIVE,,}" != "true" ]]; then
        log "ERROR" "Non-interactive mode required"
        exit 1
    fi

    if [[ -z "${ADMIN_PASSWORD}" ]]; then
        log "ERROR" "ADMIN_PASSWORD environment variable not set"
        exit 1
    fi

    if [[ -z "${SQL_ROOT_PASSWORD}" ]]; then
        log "ERROR" "SQL_ROOT_PASSWORD environment variable not set"
        exit 1
    fi

    command -v jq >/dev/null 2>&1 || {
        log "ERROR" "jq is required but not installed"
        exit 1
    }
}

# --------------------------
# Helper Function: run_bench
# --------------------------
run_bench() {
    local bench_cmd="/home/{{ frappe_user }}/frappe-env/bin/bench"
    local venv_activate="/home/{{ frappe_user }}/frappe-env/bin/activate"
    local bench_dir="{{ bench_dir }}"
    
    local command_chain="\
        set -a && \
        source ${venv_activate} && \
        export PATH=${bench_dir}/env/bin:\$PATH && \
        cd ${bench_dir} && \
        ${bench_cmd} $@"
    
    if [[ "$EUID" -eq 0 ]]; then
        sudo -u "{{ frappe_user }}" bash -c "${command_chain}"
    else
        bash -c "${command_chain}"
    fi
}

# --------------------------
# Virtual Environment Setup
# --------------------------
setup_virtualenv() {
    local venv_path="/home/{{ frappe_user }}/frappe-env"
    if [[ ! -d "${venv_path}" ]]; then
        log "INFO" "Creating Python virtual environment"
        python3 -m venv "${venv_path}" || { log "ERROR" "Failed to create virtual environment"; exit 1; }
    fi
    log "INFO" "Upgrading pip and installing bench"
    "${venv_path}/bin/pip" install --upgrade pip
    "${venv_path}/bin/pip" install frappe-bench || { log "ERROR" "Failed to install frappe-bench"; exit 1; }
}

# --------------------------
# Bench Initialization
# --------------------------
init_bench() {
    log "INFO" "Initializing bench directory at {{ bench_dir }}"
    
    run_bench init "{{ bench_dir }}" \
        --python /home/{{ frappe_user }}/frappe-env/bin/python \
        --frappe-path https://github.com/frappe/frappe \
        --frappe-branch "{{ frappe_version }}" || {
        log "ERROR" "Bench initialization failed"
        exit 1
    }
}

# --------------------------
# Application Installation
# --------------------------
install_apps() {
    log "INFO" "Processing applications to install"
    
    # Loop through apps_to_install (expected to be provided as JSON array)
    while IFS= read -r app; do
        name=$(jq -r '.name' <<< "${app}")
        repo=$(jq -r '.repo // empty' <<< "${app}")
        
        log "INFO" "Installing application: ${name}"
        if [[ -n "${repo}" ]]; then
            run_bench get-app "${name}" "${repo}" --branch "{{ erpnext_version }}" || {
                log "ERROR" "Failed to install ${name} from ${repo}"
                exit 1
            }
        else
            run_bench get-app "${name}" --branch "{{ erpnext_version }}" || {
                log "ERROR" "Failed to install ${name}"
                exit 1
            }
        fi

        run_bench --site "${SITE_NAME}" install-app "${name}" || {
            log "ERROR" "Failed to enable ${name} on site"
            exit 1
        }
            
    done <<< "$(echo "${APPS_JSON}" | jq -c '.[]')"
}

# --------------------------
# Production Setup
# --------------------------
configure_production() {
    log "INFO" "Configuring production environment"
    run_bench setup production "{{ frappe_user }}" || {
        log "ERROR" "Production setup failed"
        exit 1
    }
}

# --------------------------
# Development Setup
# --------------------------
configure_development() {
    log "INFO" "Building development assets"
    run_bench build || {
        log "ERROR" "Asset build failed"
        exit 1
    }
}

# --------------------------
# Main Execution
# --------------------------
main() {
    log "INFO" "Starting ERPNext installation"
    validate_environment
    setup_virtualenv

    if [[ ! -d "{{ bench_dir }}" ]]; then
        init_bench
    else
        log "INFO" "Using existing bench directory"
    fi

    log "INFO" "Creating site ${SITE_NAME}"
    # Run bench new-site as the non-root user.
    run_bench new-site "${SITE_NAME}" --db-root-password "${SQL_ROOT_PASSWORD}" --admin-password "${ADMIN_PASSWORD}" || {
        log "ERROR" "Site creation failed"
        exit 1
    }

    # Save the site name so bench knows which site to serve.
    echo "${SITE_NAME}" > "{{ bench_dir }}/currentsite.txt"

    # Install ERPNext app.
    log "INFO" "Installing ERPNext app"
    run_bench get-app erpnext https://github.com/frappe/erpnext --branch "{{ erpnext_version }}"
    run_bench --site "${SITE_NAME}" install-app erpnext

    # Loop through additional apps.
    if [[ -n "${APPS_JSON}" ]]; then
        install_apps
    else
        log "INFO" "No additional apps defined; skipping."
    fi

    log "INFO" "Disabling maintenance mode"
    run_bench --site "${SITE_NAME}" set-maintenance-mode off

    log "INFO" "Enabling scheduler"
    run_bench --site "${SITE_NAME}" enable-scheduler || echo -e "${RED}Warning: Enabling scheduler failed. Proceeding...${NC}"

    if [[ "${PRODUCTION_INSTALL,,}" == "yes" ]]; then
        configure_production
    else
        configure_development
    fi

    log "SUCCESS" "ERPNext installation completed successfully"
    echo -e "${GREEN}ERPNext deployment complete!${NC}"
}

main
